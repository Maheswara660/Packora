# NDK
obj/

# Gradle files
.gradle/
build/
*/build/
app/build/
template/build/

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
*.iml
.idea/
!.idea/vcs.xml
!.idea/codeStyles/

# Keystore files
# Packora generates custom keystores (.p12, .jks, .keystore) dynamically, so we ignore generated binaries.
*.jks
*.keystore
*.p12

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Kotlin
.kotlin/

# APKs and App Bundles
*.apk
*.apks
*.aab
*.apxc
*.idsig
*.output-metadata.json
baselineProfiles/
release/
app/release/

# Packora EXCEPTION: Do NOT ignore the compiled template WebAPK asset!
!app/src/main/assets/template/webview_shell.apk

# Mac OS
.DS_Store
.AppleDouble
.LSOverride

# Temporary scratch scripts (Python & Shell scripts used for testing/patching)
scratch/
*.py
__pycache__/

# VS Code
.vscode/

# Secrets & Environment
.env
*.env
keystore.properties
secrets.properties
google-services.json

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Runtime-generated app data (history icons saved by Packora at build time)
history_icons/
generated_keystores/

# Profiler & Crash Dumps
*.hprof
hs_err_pid*

# Build Reports & Diagnostics
reports/
lint/
problems/
compose_compiler/

# Temporary IDE / Brain caches
.tempmediaStorage/
.system_generated/
temp_release
temp/

# Docs Website
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/.temp/
docs/.vitepress/cache/
