            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasNeonIndigo"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_neon_indigo"
            android:roundIcon="@mipmap/ic_launcher_round_neon_indigo"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
