            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasDeepSapphire"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_deep_sapphire"
            android:roundIcon="@mipmap/ic_launcher_round_deep_sapphire"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
